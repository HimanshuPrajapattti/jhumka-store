# --- AVRANI store configuration (copy to .env.local) ---

# WhatsApp business number (country code + number, no + or spaces)
WHATSAPP_NUMBER=919256863315

# Admin panel credentials
ADMIN_EMAIL=admin@avrani.in
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie (any long random string)
SESSION_SECRET=generate-a-long-random-string-here

# Optional persistent storage paths (recommended for Render persistent disks)
# AVRANI_DB_PATH=/var/data/avrani.db
# AVRANI_UPLOADS_DIR=/var/data/uploads
